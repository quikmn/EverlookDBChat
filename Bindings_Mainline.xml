	</Binding>
	<Binding name="EDBCHAT_NEXTTAB" category="ADDONS">
		local mod = EverlookDBChat:GetModule("KeyBindings")
		if mod then
			mod:CycleChatTabs()
		end
	</Binding>
	<!-- TellTarget -->
	<Binding name="EDBCHAT_TELLTARGET" category="ADDONS">
		local mod = EverlookDBChat:GetModule("TellTarget")
		if mod then
			mod:SendTellToTarget(SELECTED_CHAT_FRAME, "");
		end
	</Binding>
	<!-- CopyChat -->
	<Binding name="EDBCHAT_COPYCHAT" category="ADDONS">
		local mod = EverlookDBChat:GetModule("CopyChat")
		if mod then
			mod:CopyChat();
		end
	</Binding>
	<Binding name="EDBCHAT_SCROLLBOTTOM" category="ADDONS">
		SELECTED_CHAT_FRAME:ScrollToBottom()
	</Binding>
	<Binding name="EDBCHAT_SCROLLTOP" category="ADDONS">
		SELECTED_CHAT_FRAME:ScrollToTop()
	</Binding>
	<!-- Calm -->
	<Binding name="EDBCHAT_FOCUS" category="ADDONS">
		if EverlookDBChat_ToggleFocus then EverlookDBChat_ToggleFocus() end
	</Binding>
</Bindings>
