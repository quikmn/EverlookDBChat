	<Binding name="EDBCHAT_SMARTGROUP">
		local ChatFrame_OpenChat = _G.ChatFrame_OpenChat or _G.ChatFrameUtil.OpenChat
		ChatFrame_OpenChat("/smart");
	</Binding>
	<Binding name="EDBCHAT_NEXTTAB">
		local mod = EverlookDBChat:GetModule("KeyBindings")
		if mod then
			mod:CycleChatTabs()
		end
	</Binding>
	<!-- TellTarget -->
	<Binding name="EDBCHAT_TELLTARGET">
		local mod = EverlookDBChat:GetModule("TellTarget")
		if mod then
			mod:SendTellToTarget(SELECTED_CHAT_FRAME, "");
		end
	</Binding>
	<!-- CopyChat -->
	<Binding name="EDBCHAT_COPYCHAT">
		local mod = EverlookDBChat:GetModule("CopyChat")
		if mod then
			mod:CopyChat();
		end
	</Binding>
	<Binding name="EDBCHAT_SCROLLBOTTOM">
		SELECTED_CHAT_FRAME:ScrollToBottom()
	</Binding>
	<Binding name="EDBCHAT_SCROLLTOP">
		SELECTED_CHAT_FRAME:ScrollToTop()
	</Binding>
	<!-- Calm -->
	<Binding name="EDBCHAT_FOCUS">
		if EverlookDBChat_ToggleFocus then EverlookDBChat_ToggleFocus() end
	</Binding>
</Bindings>
